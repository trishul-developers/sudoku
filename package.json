{
  "name": "sudoku-offline",
  "version": "1.0.0",
  "private": true,
  "description": "Dependency-free offline Sudoku PWA and Android WebView app",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.cjs",
    "sync:android": "node scripts/sync-android.mjs",
    "check": "npm test && npm run sync:android",
    "version:set": "node scripts/set-version.mjs",
    "package:pwa": "bash scripts/package-pwa.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
